{
  "name": "@poker-trainer/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:generate": "prisma generate --config prisma.config.ts",
    "db:push": "prisma db push --config prisma.config.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:sql": "tsx scripts/generate-seed-sql.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "7.10.0",
    "@prisma/client": "7.10.0"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "prisma": "7.10.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
