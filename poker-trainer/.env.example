DATABASE_URL="mysql://poker:poker@127.0.0.1:3306/poker_trainer"

# The runtime adapter reads the same URL. Keep the database on utf8mb4.
AI_PROVIDER="qwen"
AI_PLAYER_MODEL="qwen3.8-flash"
AI_REVIEW_MODEL="deepseek-v4-pro"
DASHSCOPE_API_KEY=""
DEEPSEEK_API_KEY=""
QWEN_API_KEY=""
QWEN_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"
AI_PLAYER_MAX_LLM_DECISIONS_PER_TURN="2"

# Single-user access control. Use a random secret of at least 32 characters.
AUTH_SECRET="replace-with-at-least-32-random-characters"
APP_LOGIN_USERNAME="owner"
APP_LOGIN_PASSWORD="replace-with-a-long-unique-login-password"
